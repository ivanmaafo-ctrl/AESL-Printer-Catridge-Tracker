rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection health check document
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Super Admin collection
    match /admins/{userId} {
      allow read, write, delete: if isSignedIn();
    }

    // Staff Profiles
    match /users/{userId} {
      allow read, write, delete: if isSignedIn();

      match /private/{docId} {
        allow read, write, delete: if isSignedIn();
      }
    }

    // Staff Invites
    match /staffInvites/{inviteId} {
      allow read, write, delete: if isSignedIn();
    }

    // Warehouse Cartridge SKUs
    match /cartridges/{cartridgeId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // AESL Branches & Headquarters Offices
    match /branches/{branchId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // Cartridge Dispatches
    match /dispatches/{dispatchId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // Branch Usage / Printer Swap Logs
    match /usages/{usageId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // Supplier Restock PO Receipts
    match /restocks/{restockId} {
      allow read, list, create, update, delete: if isSignedIn();
    }
  }
}
